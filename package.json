{
  "name": "dsh-yearn",
  "version": "0.1.0",
  "description": "思念：给 AI 伙伴看的两个数——它多久没说话，和你回头翻旧东西的次数。分数只由时间算。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ai-companion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syy978525-pixel/dsh-yearn.git"
  },
  "homepage": "https://github.com/syy978525-pixel/dsh-yearn#readme",
  "bugs": {
    "url": "https://github.com/syy978525-pixel/dsh-yearn/issues"
  },
  "main": "lib/index.js",
  "scripts": {
    "check": "node --check client.js && node --check lib/index.js && node --check lib/core.js && node --test test/core.test.mjs test/host.test.mjs test/fields.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}

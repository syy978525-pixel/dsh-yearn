{
  "name": "dsh-yearn",
  "version": "0.1.0",
  "description": "等与回头：只由时间算的「等你多久」+ 我回头翻旧东西的记录。分数只由时间算，别的东西一律不许碰它。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ai-companion"
  ],
  "main": "lib/index.js",
  "scripts": {
    "check": "node --check client.js && node --check lib/index.js && node --check lib/core.js && node --test test/core.test.mjs test/host.test.mjs test/fields.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
